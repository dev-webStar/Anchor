# ── Database ─────────────────────────────────────────────────────────────
# Leave empty in development: a local Postgres starts by itself in ./.anchor-db
# with a demo company. In production, use any Postgres 14+ (Supabase, Neon, Railway…).
DATABASE_URL=

# ── Where companies pay you (shown on their Billing page) ───────────────
ANCHOR_MPESA_PAYBILL=
ANCHOR_MPESA_TILL=
ANCHOR_BANK_NAME=
ANCHOR_BANK_BRANCH=
ANCHOR_BANK_ACCOUNT_NAME=
ANCHOR_BANK_ACCOUNT_NUMBER=
ANCHOR_BANK_SWIFT=

# ── Optional: M-Pesa prompts (Safaricom Daraja STK push) ────────────────
# When all of these are set, owners can pay by entering their PIN on a prompt
# and the plan switches on automatically.
PUBLIC_URL=https://your-domain.example
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_SECRET=a-long-random-string
